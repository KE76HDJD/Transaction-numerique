# ============================================
# Transaction Data Platform - Database Config
# ============================================
# Copie ce fichier en .env et remplis les valeurs
#
#   cp .env.example .env
#
# Puis modifie les valeurs ci-dessous

# Host PostgreSQL
DB_HOST=localhost

# Port PostgreSQL
DB_PORT=5432

# Nom de la base de donnees
DB_NAME=transaction_db

# Utilisateur PostgreSQL
DB_USER=kevin

# Mot de passe PostgreSQL
DB_PASSWORD=kevin123
